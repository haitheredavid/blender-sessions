  "model": "witch-frame",
  "pack": "print",
  "intent": "3D-printable shadow-box frame for a 9x12in witch illustration: concave bat-wing sides with flared corner tips, a face sloping from a thin outer edge into a deep sightwell, and a rabbet with turn clips for a 10x13in backboard.",
  "created": "2026-10-11T14:02:09-04:00",
  "source": {
    "repo": "blender-sessions",
    "commit": "921c1f6",
    "blend": "models/witch-frame/model.blend"
  },
